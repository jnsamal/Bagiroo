# ---------- General ----------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Comma-separated origins are supported. For a direct Netlify -> Render API
# connection in production use COOKIE_SAME_SITE=none and COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Render persistent disk mount. Leave unset locally to use ./uploads.
UPLOAD_DIR=

# ---------- Database (MySQL) ----------
DATABASE_URL="mysql://user:password@localhost:3306/bagiroo_co"

# ---------- Auth / JWT ----------
JWT_SECRET=change_me_dev_only
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change_me_dev_only

# ---------- OTP / SMS provider ----------
# Choose one adapter implementation in server/src/services/sms.provider.js
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=BAGCO
OTP_EXPIRES_IN_MINUTES=5
OTP_LENGTH=6

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- WhatsApp / social ----------
WHATSAPP_BUSINESS_NUMBER=

# ---------- Misc ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_ATTEMPTS=5

# ---------- Frontend build (set in Netlify, not Render) ----------
# VITE_API_URL=https://your-api.onrender.com
