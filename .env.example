# ---------- General ----------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Comma-separated origins are supported. For a direct Netlify -> Render API
# connection in production use COOKIE_SAME_SITE=none and COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# New production uploads should use Cloudinary. Local mode remains available
# for development and keeps existing /uploads paths readable during migration.
MEDIA_STORAGE=local
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Render persistent disk mount for legacy assets. Leave unset locally.
UPLOAD_DIR=

# ---------- Database (MySQL) ----------
DATABASE_URL="mysql://user:password@localhost:3306/bagiroo_co"

# ---------- Auth / JWT ----------
JWT_SECRET=change_me_dev_only
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change_me_dev_only

# ---------- OTP / email provider ----------
# Use console locally. In production, use brevo with a verified sender.
EMAIL_PROVIDER=console
# Required only when EMAIL_PROVIDER=brevo.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=login@your-domain.com
EMAIL_FROM_NAME="Bagiroo & Co."
# Legacy Resend configuration, required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
EMAIL_FROM="Bagiroo & Co. <login@your-domain.com>"
OTP_EXPIRES_IN_MINUTES=5
OTP_LENGTH=6

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- WhatsApp / social ----------
WHATSAPP_BUSINESS_NUMBER=

# ---------- Misc ----------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_ATTEMPTS=5

# ---------- Frontend build (set in Netlify, not Render) ----------
# VITE_API_URL=https://your-api.onrender.com
